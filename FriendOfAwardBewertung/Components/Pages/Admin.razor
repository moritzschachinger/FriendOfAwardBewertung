@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using QRCoder;
@inject TokenService Tokens
@rendermode InteractiveServer
@page "/admin"

<AuthorizeView Roles="Admin">
    <Authorized>
        <p>Hallo Admin</p>    
        <button class="btn" @onclick="GenerateQr">QR-Code erzeugen</button>

        @if (qrBytes != null)
        {
            <img src="data:image/png;base64,@Convert.ToBase64String(qrBytes)" />
        }

    </Authorized>
    <NotAuthorized>
        <h1 style="color:red">Not Authorized to enter this page</h1>
    </NotAuthorized>
</AuthorizeView>

@code{

    private byte[]? qrBytes;
    QRCodeService QRCode = new QRCodeService();

    private async Task GenerateQr()
    {
        string token = Tokens.GenerateToken();

        string url = $"https://localhost:5001/userlogin?code={token}";

        // Token in DB speichern
        Tokens.SaveToken(token);
        

        // QR-Bild erzeugen
        qrBytes = QRCode.GenerateQRCodeImage(url);
    }

}