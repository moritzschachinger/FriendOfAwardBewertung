@code{

    private string currentPage = "/admin";
    DbWrapperMySqlV2 dbWrapper = DbWrapperMySqlV2.Wrapper;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        Console.WriteLine("Home - IsAuthenticated: " + user.Identity?.IsAuthenticated);
        Console.WriteLine("Home - Roles: " + string.Join(',', user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value)));


    }
    void LoadDataAsync()
    {
        

    }
    void GoTo(string page)
    {
        currentPage = page;
        Nav.NavigateTo(currentPage);

    }
   
}
