@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using QRCoder;
@inject TokenService Tokens
@inject NavigationManager Nav
@rendermode InteractiveServer
@page "/admin"

<AuthorizeView>
    <Authorized>
        <div class="admin-layout">

            <!-- SIDEBAR -->
            <aside class="sidebar">
                <h2>Admin</h2>

                <nav>
                    <button @onclick="@(() => GoTo("/dashboard"))">Dashboard</button>
                    <button @onclick="@(() => GoTo("/qrcode"))">QR-Codes</button>
                    <button @onclick="@(() => GoTo("/import"))">Excel Import</button>
                    <button @onclick="@(() => GoTo("/export"))">Excel Export</button>

                </nav>

               
            </aside>

           

        </div>
    </Authorized>
    <NotAuthorized>
        <h1 style="color:red">Not Authorized to enter this page</h1>
    </NotAuthorized>
</AuthorizeView>

@code{

    private string currentPage = "/admin";

    void GoTo(string page)
    {
        currentPage = page;
        Nav.NavigateTo(currentPage);

    }

   

}