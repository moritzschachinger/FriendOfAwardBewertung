@page "/admin"
@using FriendOfAwardBewertung.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@layout AdminLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth


<h1>📊 Admin Dashboard</h1>
<AuthorizeView>
    <Authorized>



        <div class="dashboard">

            <!-- HEADER -->
            <div class="dashboard-header">
                <h1>Publikumsvoting – Übersicht</h1>
                <span class="status running">🟢 Voting läuft</span>
            </div>

            <!-- INFO BOXEN -->
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="label">Diplomarbeiten</span>
                    <span class="value">20</span>
                </div>

                <div class="stat-card">
                    <span class="label">Abgegebene Stimmen</span>
                    <span class="value">124</span>
                </div>

                <div class="stat-card">
                    <span class="label">Max. Publikumspunkte</span>
                    <span class="value">30</span>
                </div>

                <div class="stat-card time-card">
                    <span class="label">Voting endet um</span>
                    <span class="time">18:30</span>
                    <button class="small-btn">Zeit ändern</button>
                </div>
            </div>

            <!-- TABELLE -->
            <div class="card">
                <h2>Gesamtreihung (20 Diplomarbeiten)</h2>

                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>Platz</th>
                            <th>Diplomarbeit</th>
                            <th>Schule</th>
                            <th>Publikum</th>
                            <th>Gesamt</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(Diplomarbeit d in diplomarbeiten)
                        {
                            @if(d.Id <= 6)
                            {
                                style = "top6";
                                preisgeld = "🏆 Finalist";
                            }
                            else if(d.Id>=7 && d.Id <= 13)
                            {
                                style = "mid";
                                preisgeld = "💰 100 €";
                            }
                            else
                            {
                                style = "low";
                                preisgeld = "🎁 50 €";
                            }
                            <tr class="@style">
                                <td>@d.Id</td>
                                <td>@d.Name</td>
                                <td>38</td>
                                <td>30</td>
                                <td>68</td>
                                <td>@preisgeld</td>
                            </tr>
                        }
                        <!-- TOP 6 -->
                        
                    </tbody>
                </table>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
                <button class="danger">Publikumsvoting jetzt beenden</button>
                <button class="export">Gesamtauswertung exportieren</button>
            </div>

        </div>


    </Authorized>
    <NotAuthorized>
        <p style="color:red">Sie sind nicht berechtigt, auf diese Seite zuzugreifen. Bitte <a href="/adminlogin">loggen Sie sich ein</a>.</p>
    </NotAuthorized>
</AuthorizeView>


@code{

    private string currentPage = "/admin";
    DbWrapperMySqlV2 dbWrapper = DbWrapperMySqlV2.Wrapper;
    List<Diplomarbeit> diplomarbeiten = [];
    string style = "";
    string preisgeld = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        Console.WriteLine("Home - IsAuthenticated: " + user.Identity?.IsAuthenticated);
        Console.WriteLine("Home - Roles: " + string.Join(',', user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value)));
        await LoadDataAsync();

    }
    async Task LoadDataAsync()
    {
        diplomarbeiten = await Diplomarbeit.LoadDiplomarbeitenAsync();

    }
    void GoTo(string page)
    {
        currentPage = page;
        Nav.NavigateTo(currentPage);

    }
   
}
