@page "/admin"

@using FriendOfAwardBewertung.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using ClosedXML.Excel
@layout AdminLayout


@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS



<h1>📊 Admin Dashboard</h1>

<AuthorizeView>
    <Authorized>

        <div class="dashboard">

            <!-- HEADER -->
            <div class="dashboard-header">
                <h2>Publikumsvoting – Übersicht</h2>

                @if (VotingLaeuft)
                {
                    <span class="status running">🟢 Voting läuft</span>
                }
                else
                {
                    <span class="status stopped">🔴 Voting beendet</span>
                }
            </div>

            <!-- STATS -->
            <div class="stats-grid">

                <div class="stat-card">
                    <span>Diplomarbeiten</span>
                    <strong>20</strong>
                </div>

                <div class="stat-card">
                    <span>Max. Publikumspunkte</span>
                    <strong>30</strong>
                </div>

                <div class="stat-card time-card">
                    <span>Voting endet um</span>

                    <input type="datetime-local"
                           @bind="VotingEndInput" />

                    <button class="small-btn" @onclick="SaveVotingTime">
                        💾 Speichern
                    </button>
                </div>
            </div>

            <!-- EXCEL IMPORT -->
            <div class="excel-import">
                <InputFile OnChange="HandleExcelUpload" accept=".xlsx" />
                <button class="btn btn-primary" @onclick="ImportExcel">
                    Excel importieren
                </button>

                @if (!string.IsNullOrEmpty(importError))
                {
                    <p style="color:red">@importError</p>
                }

                @if (excelLoaded)
                {
                    <p style="color:green">✔ @loadedCount Datensätze geladen</p>
                }
            </div>

            <!-- TABELLE -->
            <div class="card">
                <h3>Gesamtreihung</h3>

                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>Platz</th>
                            <th>Diplomarbeit</th>
                            <th>Schule</th>
                            <th>Publikum</th>
                            <th>Gesamt</th>
                            <th>Preis</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            count = 1;
                        }

                        @foreach (var d in AnzeigeListe)
                        {
                            string klasse;
                            string preis;

                            if (count <= 6)
                            {
                                klasse = "top6";
                                preis = "🏆 Finalist";
                            }
                            else if (count <= 13)
                            {
                                klasse = "mid";
                                preis = "💰 100 €";
                            }
                            else
                            {
                                klasse = "low";
                                preis = "🎁 50 €";
                            }

                            <tr class="@klasse">
                                <td>@count</td>
                                <td>@d.Name</td>
                                <td>@d.PunkteSchulvoting</td>
                                <td>@d.PunktePublikumsvoting</td>
                                <td>@(d.PunkteSchulvoting + d.PunktePublikumsvoting)</td>
                                <td>@preis</td>
                            </tr>

                            count++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
                <button class="danger" @onclick="BeendeVoting">
                    ⛔ Voting jetzt beenden
                </button>

                <button class="export" @onclick="ExportExcel">
                    📥 Excel exportieren
                </button>
            </div>

        </div>
    </Authorized>
    <NotAuthorized>
        <p style="color:red">Sie sind nicht berechtigt, auf diese Seite zuzugreifen. Bitte <a href="/adminlogin">loggen Sie sich ein</a>.</p>
    </NotAuthorized>
</AuthorizeView>

@code {

    bool excelLoaded = false;
    string? importError;
    IBrowserFile? uploadedFile;
    int loadedCount = 0; // Anzahl der importierten Datensätze

    private string currentPage = "/admin";
    DbWrapperMySqlV2 dbWrapper = DbWrapperMySqlV2.Wrapper;
    List<Diplomarbeit> diplomarbeiten = new();
    List<Diplomarbeit> AnzeigeListe = new();

    AppSettings settings = new();

    bool VotingLaeuft;
    DateTime VotingEndInput;

    int count = 1;

    System.Threading.Timer? refreshTimer;
    bool disposed = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();

        if (VotingLaeuft)
        {

            refreshTimer = new Timer(async _ =>
            {
                if (disposed) return;

                await InvokeAsync(async () =>
                {
                    await LoadAll();
                    StateHasChanged();
                });

            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else
        {
            refreshTimer?.Dispose();
        }
    }

    async Task LoadAll()
    {
        settings = AppSettings.Load();

        VotingLaeuft = settings.VotingActive &&
                       DateTime.Now < settings.VotingEnd;

        VotingEndInput = settings.VotingEnd;

        diplomarbeiten = await Diplomarbeit.LoadDiplomarbeitenAsync();
        Diplomarbeit.LoadPublikumPoints(diplomarbeiten);
        foreach (Diplomarbeit d in diplomarbeiten)
        {
            Console.WriteLine($"Name: {d.Name}      | {d.PunktePublikumsvoting} | {d.PunkteSchulvoting}");
        }
        Console.WriteLine("#######################################################################################");
        if (!VotingLaeuft)
            CalculateLinearPoints(diplomarbeiten);

        AnzeigeListe = diplomarbeiten
            .OrderByDescending(d => d.PunkteSchulvoting + d.PunktePublikumsvoting)
            .ToList();
    }

    void CalculateLinearPoints(List<Diplomarbeit> list)
    {
        if(list == null || list.Count == 0)
            return;

        int max = list.Max(d => d.PunktePublikumsvoting);

        foreach (var d in list)
        {
            int roh = d.PunktePublikumsvoting;

            d.PunktePublikumsvoting =
                max == 0
                    ? 0
                    : (int)Math.Round((roh / (double)max) * 30);
        }
    }

    async void SaveVotingTime()
    {
        AppSettings.Update(VotingEndInput, true);
        await LoadAll();
    }


    async void BeendeVoting()
    {
        AppSettings.Update(DateTime.Now, false);
        await LoadAll();
    }

    async Task ExportExcel()
    {
        var sortiert = diplomarbeiten
       .OrderByDescending(d => d.PunkteSchulvoting + d.PunktePublikumsvoting)
       .ToList();

        byte[] file = ExcelExportHelper.CreateExport(sortiert);

        await JS.InvokeVoidAsync(
            "downloadFile",
            "FriendsOfAward_Gesamtauswertung.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            file
        );
    }


    void GoTo(string page)
    {
        currentPage = page;
        Nav.NavigateTo(currentPage);
    }

    void HandleExcelUpload(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;
        excelLoaded = false;
        importError = null;
        loadedCount = 0;
    }

    async Task ImportExcel()
    {
        dbWrapper.Open();
        try
        {
            if (uploadedFile == null)
            {
                importError = "Keine Datei ausgewählt.";
                return;
            }

            // Alte Daten löschen
            dbWrapper.RunNonQuery("DELETE FROM diplomarbeiten");
            dbWrapper.RunNonQuery("TRUNCATE TABLE diplomarbeiten_punkte");

            using var browserStream = uploadedFile.OpenReadStream(5_000_000);
            using var ms = new MemoryStream();
            await browserStream.CopyToAsync(ms);
            ms.Position = 0;

            using var workbook = new XLWorkbook(ms);
            var sheet = workbook.Worksheet(1);

            var rows = sheet.RowsUsed().Skip(1).ToList();

            if (rows.Count != 20)
            {
                importError = "Die Excel-Datei muss GENAU 20 Einträge enthalten.";
                return;
            }

            loadedCount = 0;

            foreach (var row in rows)
            {
                var laufendeNummer = row.Cell(1).GetValue<int>();
                var titel = row.Cell(2).GetString().Replace("'", "''");
                var schueler = row.Cell(3).GetString().Replace("'", "''");
                var punkte = row.Cell(4).GetValue<int>();

                if (laufendeNummer < 1 || laufendeNummer > 20)
                    throw new Exception("Ungültige laufende Nummer");

                string sql = $"INSERT INTO diplomarbeiten (id, Diplomarbeit, namenSchüler, punkteSchulvoting) " +
                             $"VALUES ({laufendeNummer}, '{titel}', '{schueler}', {punkte})";

                string sql2 = "INSERT INTO diplomarbeiten_punkte (id, diplomarbeit_id, punkte)"+
                $"VALUES (DEFAULT, {laufendeNummer}, 0)";

                try
                {
                    dbWrapper.RunNonQuery(sql);
                    dbWrapper.RunNonQuery(sql2);
                    loadedCount++;
                    dbWrapper.Close();
                }
                catch (Exception ex)
                {
                    dbWrapper.Close();
                    Console.WriteLine("Fehler beim Speichern in DB: " + ex.Message);
                    importError = "Fehler beim Speichern in der Datenbank.";
                    return;
                }
            }

            excelLoaded = true;
            importError = null;
            Console.WriteLine($"Excel erfolgreich gelesen und {loadedCount} Datensätze in DB gespeichert.");
        }
        catch (Exception ex)
        {
            importError = "Excel-Import fehlgeschlagen: " + ex.Message;
        }
    }


}




