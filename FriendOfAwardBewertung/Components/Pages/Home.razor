@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Collections.Specialized

@inject NavigationManager Nav
@inject TokenService TokenService
@inject MyCustomAuthStateProvider Auth




<AuthorizeView>
    <Authorized>
        <h1 class="title">Friends of Award</h1>
        <div class="subtitle">
            Geben Sie uns Ihre persönlichen Favoriten bekannt!<br />
            <strong>Einfacher Klick = Favorit (max. 5)</strong><br />
            <strong>Doppelklick = Topfavorit (max. 1)</strong><br />
            <span class="note">Diese Abstimmung ist anonym und auf ein GerÃ¤t beschrÃ¤nkt.</span>
        </div>

        <div class="page-wrapper @(showConfirm ? "blurred" : "")">

            <div class="grid-container">
                @foreach (var number in numbers)
                {
                    <button class="grid-button @(GetButtonClass(number))"
                            @onclick="@(() => OnClick(number))"
                            @ondblclick="@(() => OnDoubleClick(number))">
                        <span>@number</span>

                        @if (topfavorit == number)
                        {
                            <span class="star-group">??</span>
                        }
                        else if (favorites.Contains(number))
                        {
                            <span class="star-single">?</span>
                        }
                    </button>
                }
            </div>

            <div class="info">
                Offen: @remainingFavorites Favoriten, @remainingTopfavorit Topfavorit
            </div>

            <button class="submit-button"
                    @onclick="Btn_BewertungAbsenden"
                    disabled="@IsSubmitDisabled">
                Bewertung absenden
            </button>

        </div>

        @if (showConfirm)
        {
            <div class="modal-overlay">
                <div class="confirm-modal">

                    <h2>Bewertung bestätigen</h2>

                    <div class="section">
                        <strong>Favoriten (+1 Punkt):</strong>
                        <ul>
                            @foreach (var f in favorites)
                            {
                                <li>Diplomarbeit ID @f</li>
                            }
                        </ul>
                    </div>

                    <div class="section">
                        <strong>Topfavorit (+2 Punkte):</strong>
                        <p>Diplomarbeit ID @topfavorit</p>
                    </div>

                    <div class="modal-actions">
                        <button class="btn-cancel" @onclick="CancelConfirm">
                            Abbrechen
                        </button>
                        <button class="btn-confirm" @onclick="ConfirmSubmit">
                            Bestätigen
                        </button>
                    </div>

                </div>
            </div>
        }
        <div class="diploma-legend">
            <h3>Diplomarbeiten � �bersicht</h3>

            <div class="diploma-legend-list">
                @foreach (var d in diplomarbeiten)
                {
                    <div class="diploma-legend-item">
                        <span class="diploma-number">@d.Id</span>
                        <span class="diploma-text">@d.Name</span>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <h1 style="color:red">Nicht berechtigt, diese Seite zu betreten</h1>
    </NotAuthorized>
</AuthorizeView>
        






@code {
    private List<int> numbers = Enumerable.Range(1, 20).ToList();
    private List<int> favorites = new();
    private List<Diplomarbeit> diplomarbeiten = new();
    private int? topfavorit = null;
    private bool showConfirm = false;
    bool IsSubmitDisabled = false;

    private int remainingFavorites => 5 - favorites.Count;
    private int remainingTopfavorit => topfavorit == null ? 1 : 0;

    private bool _authDone = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authDone)
            return;

        _authDone = true;

        Uri uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        string token = query["code"];

        if (string.IsNullOrWhiteSpace(token))
            return;

        if (!TokenService.ValidateToken(token))
        {
            Console.WriteLine("Token ungültig");
            return;
        }

        // LOGIN
        Auth.Login(token);

        // TOKEN EINMALIG VERBRAUCHEN
        TokenService.MarkTokenAsUsed(token);

        Console.WriteLine("User erfolgreich authentifiziert");

        StateHasChanged(); // wichtig für AuthorizeView
    }


    protected override async Task OnInitializedAsync()
    {
        diplomarbeiten = await Diplomarbeit.LoadDiplomarbeitenAsync();
    }


    private void OnClick(int number)
    {
        if (topfavorit == number)
        {
            topfavorit = null;
            return;
        }

        if (favorites.Contains(number))
        {
            favorites.Remove(number);
        }
        else if (favorites.Count < 5)
        {
            favorites.Add(number);
        }
    }

    private void OnDoubleClick(int number)
    {
        topfavorit = number;
        favorites.Remove(number);
    }

    private string GetButtonClass(int number)
    {
        if (topfavorit == number) return "topfavorite";
        if (favorites.Contains(number)) return "favorite";
        return "";
    }

    private void Btn_BewertungAbsenden()
    {
        showConfirm = true;
    }

    private async Task ConfirmSubmit()
    {
        showConfirm = false;

        DbWrapperMySqlV2 wrapper = DbWrapperMySqlV2.Wrapper;

        try
        {
            int numRecords;
            foreach (int f in favorites)
            {
                string sql1 =
                    $"UPDATE diplomarbeiten_punkte " +
                    $"SET punkte = punkte + 1 " +
                    $"WHERE diplomarbeit_id = {f};";

                numRecords = wrapper.RunNonQuery(sql1);
                if (numRecords != 1)
                    Console.WriteLine($"DB-Error bei Favorit {f}");
            }

            string sql2 =
                $"UPDATE diplomarbeiten_punkte " +
                $"SET punkte = punkte + 2 " +
                $"WHERE diplomarbeit_id = {topfavorit};";

            numRecords = wrapper.RunNonQuery(sql2);
            if (numRecords != 1)
                Console.WriteLine($"DB-Error bei Topfavorit {topfavorit}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        IsSubmitDisabled = true;
    }

    private void CancelConfirm()
    {
        showConfirm = false;
    }
}






<style>
    .diploma-legend {
        margin: 40px auto 0 auto;
        max-width: 520px;
        text-align: left;
    }

        .diploma-legend h3 {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .diploma-legend-list {
