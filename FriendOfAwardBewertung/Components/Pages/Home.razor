@rendermode InteractiveServer
@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject NavigationManager Nav
@inject TokenService TokenService
@inject MyCustomAuthStateProvider Auth


<div class="page-wrapper @(showConfirm ? "blurred" : "")">

    <div class="grid-container">
        @foreach (var number in numbers)
        {
            <button class="grid-button @(GetButtonClass(number))"
                    @onclick="@(() => OnClick(number))"
                    @ondblclick="@(() => OnDoubleClick(number))">
                <span>@number</span>

                @if (topfavorit == number)
                {
                    <span class="star-group">⭐⭐</span>
                }
                else if (favorites.Contains(number))
                {
                    <span class="star-single">⭐</span>
                }
            </button>
        }
    </div>

    <div class="info">
        Offen: @remainingFavorites Favoriten, @remainingTopfavorit Topfavorit
    </div>

    <button class="submit-button" @onclick="Btn_BewertungAbsenden">
        Bewertung absenden
    </button>

</div>

@if (showConfirm)
{
    <div class="modal-overlay">
        <div class="confirm-modal">

            <h2>Bewertung bestätigen</h2>

            <div class="section">
                <strong>Favoriten (+1 Punkt):</strong>
                <ul>
                    @foreach (var f in favorites)
                    {
                        <li>Diplomarbeit ID @f</li>
                    }
                </ul>
            </div>

            <div class="section">
                <strong>Topfavorit (+2 Punkte):</strong>
                <p>Diplomarbeit ID @topfavorit</p>
            </div>

            <div class="modal-actions">
                <button class="btn-cancel" @onclick="CancelConfirm">
                    Abbrechen
                </button>
                <button class="btn-confirm" @onclick="ConfirmSubmit">
                    Bestätigen
                </button>
            </div>

        </div>
    </div>
}

@code {
    private List<int> numbers = Enumerable.Range(1, 20).ToList();
    private List<int> favorites = new();
    private int? topfavorit = null;
    private bool showConfirm = false;

    private int remainingFavorites => 5 - favorites.Count;
    private int remainingTopfavorit => topfavorit == null ? 1 : 0;

    private void OnClick(int number)
    {
        if (topfavorit == number)
        {
            topfavorit = null;
            return;
        }

        if (favorites.Contains(number))
        {
            favorites.Remove(number);
        }
        else if (favorites.Count < 5)
        {
            favorites.Add(number);
        }
    }

    private void OnDoubleClick(int number)
    {
        topfavorit = number;
        favorites.Remove(number);
    }

    private string GetButtonClass(int number)
    {
        if (topfavorit == number) return "topfavorite";
        if (favorites.Contains(number)) return "favorite";
        return "";
    }

    private void Btn_BewertungAbsenden()
    {
        showConfirm = true;
    }

    private async Task ConfirmSubmit()
    {
        showConfirm = false;

        DbWrapperMySqlV2 wrapper = DbWrapperMySqlV2.Wrapper;

        try
        {
            int numRecords;
            foreach (int f in favorites)
            {
                string sql1 =
                    $"UPDATE diplomarbeiten_punkte " +
                    $"SET punkte = punkte + 1 " +
                    $"WHERE diplomarbeit_id = {f};";

                numRecords = wrapper.RunNonQuery(sql1);
                if (numRecords != 1)
                    Console.WriteLine($"DB-Error bei Favorit {f}");
            }

            string sql2 =
                $"UPDATE diplomarbeiten_punkte " +
                $"SET punkte = punkte + 2 " +
                $"WHERE diplomarbeit_id = {topfavorit};";

            numRecords = wrapper.RunNonQuery(sql2);
            if (numRecords != 1)
                Console.WriteLine($"DB-Error bei Topfavorit {topfavorit}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void CancelConfirm()
    {
        showConfirm = false;
    }
}
