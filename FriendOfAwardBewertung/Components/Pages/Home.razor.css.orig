/* ================= RESET ================= */
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
}

body {
    font-family: "Segoe UI", system-ui, sans-serif;
    background: #f2f1ef;
    color: #111;
    overflow: hidden;
}

/* ================= HEADER ================= */
.title {
    text-align: center;
    margin: 10px 0 4px;
    font-size: 1.6rem;
    font-weight: 700;
}

.subtitle {
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.35;
    margin-bottom: 8px;
}

.note {
    font-size: 0.7rem;
    color: #555;
}

/* ================= PAGE ================= */
.page-wrapper {
    min-height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* ================= GRID ================= */
.grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 520px;
    padding: 0 12px;
    margin-bottom: 10px;
}

/* ================= GRID BUTTON ================= */
.grid-button {
    height: 64px;
    border-radius: 10px;
    border: none;
    background: #e6e6e6;
    color: #000;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
}

/* ================= STATES ================= */
.favorite {
    background-color: #4caf50 !important;
    color: white;
}

.topfavorite {
    background-color: #ff9800 !important;
    color: white;
}

/* ================= STAR ================= */
.star-single,
.star-group {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.9rem;
}

/* ================= INFO ================= */
.info {
    font-weight: 600;
    font-size: 0.9rem;
    margin: 4px 0 6px;
}

/* ================= SUBMIT BUTTON (SAFTIG) ================= */
.page-wrapper .submit-button {
    padding: 12px 32px;
    margin-bottom: 2px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 14px;
    border: none;
    background: linear-gradient(180deg, #64b5f6, #42a5f5);
    color: white;
    cursor: pointer;
    box-shadow: 0 4px 0 #1e88e5, 0 8px 16px rgba(30,136,229,0.35);
    transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.12s ease;
}

    .page-wrapper .submit-button:hover {
        filter: brightness(1.05);
    }

    .page-wrapper .submit-button:active {
        transform: translateY(3px);
        box-shadow: 0 2px 0 #1e88e5, 0 4px 10px rgba(30,136,229,0.25);
        filter: brightness(0.98);
    }

/* ================= MODAL OVERLAY ================= */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
}

/* ================= MODAL ================= */
.confirm-modal {
    background: white;
    border-radius: 18px;
    padding: 24px 28px;
    width: 420px;
    max-width: 92%;
    box-shadow: 0 25px 70px rgba(0,0,0,0.4);
    animation: modalPop 0.25s ease-out;
}

@keyframes modalPop {
    from {
        transform: scale(0.92) translateY(10px);
        opacity: 0;
    }

    to {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
}

.confirm-modal h2 {
    margin-top: 0;
    text-align: center;
}

/* ================= MODAL CONTENT ================= */
.section {
    margin-bottom: 14px;
    font-size: 0.9rem;
}

/* ================= MODAL ACTIONS ================= */
.modal-actions {
    display: flex;
    gap: 12px;
    margin-top: 18px;
}

.btn-cancel,
.btn-confirm {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    cursor: pointer;
}

.btn-cancel {
    background: #e0e0e0;
}

.btn-confirm {
    background: #4caf50;
    color: white;
}

    .btn-confirm:hover {
        background: #43a047;
    }

/* ================= ÜBERSICHT ================= */
.diploma-legend {
    margin: 10px auto 0 auto;
    max-width: 520px;
    padding: 14px 16px 16px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 22px rgba(0,0,0,0.08);
}

    .diploma-legend h3 {
        text-align: center;
        margin-bottom: 12px;
        font-size: 1.05rem;
        font-weight: 600;
    }

/* 2 Spalten */
.diploma-legend-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 12px;
}

.diploma-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 10px;
    background: #f4f6f8;
    border-radius: 12px;
    font-size: 0.85rem;
}

.diploma-number {
    min-width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #4caf50;
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.diploma-text {
    color: #333;
    line-height: 1.25;
}

/* ================= MOBILE ================= */
@media (max-width: 420px) {

    .grid-button {
        height: 56px;
        font-size: 0.85rem;
    }

    .page-wrapper .submit-button {
        width: 90%;
    }
}
