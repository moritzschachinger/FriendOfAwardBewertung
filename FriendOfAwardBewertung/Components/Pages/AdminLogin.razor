@page "/adminlogin"
@using System.Data
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@inject MyCustomAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Admin Login</PageTitle>


    <div class="login-container">
        <div class="login-box">
            <h2>Admin Login</h2>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="error-box">@error</div>
            }

            <div class="input-group">
                <label>Email</label>
                <input @bind="email" type="text" />
            </div>

            <div class="input-group">
                <label>Passwort</label>
                <input @bind="password" @onkeydown="Enter" type="password" />
            </div>

            <button class="login-button" @onclick="HandleLogin">
                Login
            </button>
            <div class="forgot-password-wrapper">
                <a href="/adminforgot">Passwort vergessen?</a>
            </div>

        </div>
    </div>
  

@code {
    private string email = "";
    private string password = "";
    private string error = "";

    
    public void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            if (HandleLogin(email, password))
            {
                Auth.Login(email);
                Nav.NavigateTo("/admin");
            }
            else
            {
                error = "Falscher Benutzername oder Passwort.";
            }
        }
    }
    private void HandleLogin()
    {
        // Beispiel
        if (HandleLogin(email, password))
        {
            Auth.Login(email);
            Nav.NavigateTo("/admin");
        }
        else
        {
            error = "Falscher Benutzername oder Passwort.";
        }
    }
    private bool HandleLogin(string email, string password)
    {
        try
        {
            DbWrapperMySqlV2 wrapper = DbWrapperMySqlV2.Wrapper;
            string sql = $"SELECT email, password_hash FROM admin_users WHERE email = '{email}'";

            DataTable dt = wrapper.RunQuery(sql);

            if (dt == null || dt.Rows.Count == 0)return false;

            bool ok = BCrypt.Net.BCrypt.Verify(password, dt.Rows[0][1].ToString());
            if (!ok)
            {
                return false;
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            return false;
        }
        return true;
    }
}


